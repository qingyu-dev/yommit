{
  "name": "yommit",
  "displayName": "Yommit",
  "description": "Generate commit messages from staged Git changes with optional Gitmoji and Conventional Commit prefixes using DeepSeek or Aliyun Bailian.",
  "version": "0.0.1",
  "publisher": "qingyu-dev",
  "author": "qingyu",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/qingyu-dev/yommit.git"
  },
  "bugs": {
    "url": "https://github.com/qingyu-dev/yommit/issues"
  },
  "homepage": "https://github.com/qingyu-dev/yommit#readme",
  "keywords": [
    "vscode",
    "git",
    "commit",
    "gitmoji",
    "deepseek",
    "aliyun",
    "bailian",
    "ai"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "yommit.generateCommitMessage",
        "title": "Yommit: Generate Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "yommit.setApiKey",
        "title": "Yommit: Set API Key"
      },
      {
        "command": "yommit.selectModel",
        "title": "Yommit: Select Model"
      },
      {
        "command": "yommit.clearApiKey",
        "title": "Yommit: Clear API Key"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "yommit.generateCommitMessage",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Yommit",
      "properties": {
        "yommit.provider": {
          "type": "string",
          "enum": [
            "DeepSeek",
            "Alibaba (China)"
          ],
          "enumDescriptions": [
            "Use the DeepSeek official API.",
            "Use the Alibaba Cloud Bailian OpenAI-compatible API."
          ],
          "default": "DeepSeek",
          "description": "Model provider used to generate commit messages."
        },
        "yommit.language": {
          "type": "string",
          "enum": [
            "en",
            "zh"
          ],
          "enumDescriptions": [
            "Generate the commit summary in English.",
            "Generate the commit summary in Chinese."
          ],
          "default": "zh",
          "description": "Language for the generated commit summary."
        },
        "yommit.useGitmoji": {
          "type": "boolean",
          "default": true,
          "description": "Include a Gitmoji at the start of generated commit messages."
        },
        "yommit.useConventionalType": {
          "type": "boolean",
          "default": false,
          "description": "Include a Conventional Commit type such as feat:, fix:, docs:, chore:, or refactor: in generated commit messages."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package --no-rewrite-relative-links",
    "test": "npm run compile && node --test \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.8.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  }
}
